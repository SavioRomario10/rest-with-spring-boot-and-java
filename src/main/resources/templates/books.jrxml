	<query language="SQL"><![CDATA[SELECT b.id,
	b.author,
	launch_date AS launchDate,
	b.price,
	b.title
FROM books b
	JOIN person_books pb ON 
	 pb.book_id = b.id
	 WHERE pb.person_id = 1]]></query>
